{
  "expo": {
    "name": "golf-lesson-system-mobile",
    "slug": "golf-lesson-system-mobile",
    "version": "1.0.0",
    "newArchEnabled": true,
    "orientation": "portrait",
    "icon": "./assets/golf/mipmap-xxxhdpi/ic_launcher.png",
    "scheme": "golflessonsystemmobile",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/golf/mipmap-xxxhdpi/ic_launcher.png"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/golf/mipmap-xxxhdpi/ic_launcher_foreground.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.anonymous.golflessonsystemmobile"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-build-properties",
        {
          "android": {
            "buildToolsVersion": "36.0.0",
            "compileSdkVersion": 36,
            "minSdkVersion": 24,
            "targetSdkVersion": 36
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "android": {
            "image": "./assets/images/splash-icon.png",
            "imageWidth": 76
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}