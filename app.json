{
  "expo": {
    "name": "HappyGolf GO",
    "slug": "golf-lesson-system-mobile",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/images/Happy-Golf-V2-Icons/expo/icon.png",
    "scheme": "golflessonsystemmobile",
    "userInterfaceStyle": "automatic",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/075f354d-9980-43e0-9ae5-07584735ab10",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    },
    "ios": {
      "icon": {
        "light": "./assets/images/Happy-Golf-V2-Icons/expo/ios-icon.png"
      },
      "supportsTablet": true,
      "bundleIdentifier": "com.toweringinvest.happygolfmobile",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "icon": "./assets/images/Happy-Golf-V2-Icons/expo/android-icon.png",
      "adaptiveIcon": {
        "backgroundColor": "#5FB1FF",
        "foregroundImage": "./assets/images/Happy-Golf-V2-Icons/expo/android-adaptive-foreground.png",
        "monochromeImage": "./assets/images/Happy-Golf-V2-Icons/expo/android-adaptive-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.toweringinvest.happygolfmobile",
      "googleServicesFile": "./google-services.json",
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/expo-icons/favicon.png"
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "icon": "./assets/images/ic_appnotifi.png",
          "color": "#141e32"
        }
      ],
      "expo-router",
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 24,
            "targetSdkVersion": 36
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#2563EB",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76,
          "resizeMode": "contain"
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Allow Golf Lesson System to use your camera to take a profile photo.",
          "photosPermission": "Allow Golf Lesson System to access your photos to choose a profile photo.",
          "microphonePermission": false
        }
      ],
      [
        "expo-media-library",
        {
          "savePhotosPermission": "Allow Golf Lesson System to save activity cards to your photos.",
          "granularPermissions": []
        }
      ],
      [
        "@sentry/react-native/expo",
        {
          "url": "https://sentry.io/",
          "project": "golf-member-mobile",
          "organization": "towering-agrarian-investment"
        }
      ],
      "expo-video",
      "expo-font",
      "expo-image",
      "expo-localization",
      "expo-secure-store",
      "expo-status-bar",
      "expo-web-browser",
      "@sentry/react-native"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "075f354d-9980-43e0-9ae5-07584735ab10"
      }
    },
    "owner": "towering-agrarian-investment"
  }
}
