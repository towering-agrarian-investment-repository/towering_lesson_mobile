{
  "expo": {
    "name": "Golf Lesson System",
    "slug": "golf-lesson-system-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/ic_launcher.png",
    "scheme": "golflessonsystemmobile",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/ic_launcher.png"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#2563EB",
        "foregroundImage": "./assets/images/ic_launcher.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.anonymous.golflessonsystemmobile",
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-notifications",
      "expo-router",
      [
        "expo-build-properties",
        {
          "android": {
            "buildToolsVersion": "36.0.0",
            "compileSdkVersion": 36,
            "minSdkVersion": 24,
            "targetSdkVersion": 36
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#2563EB",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76,
          "resizeMode": "contain"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "94f7525e-6d26-48a5-a634-cc46ae8f1505"
      }
    }
  }
}