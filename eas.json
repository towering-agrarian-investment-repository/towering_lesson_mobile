{
  "cli": {
    "version": ">= 20.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "environment": "development",
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "http://localhost:8082/api/v1",
        "EXPO_PUBLIC_AUTH_BASE_URL": "http://localhost:3002/api/member/auth",
        "EXPO_PUBLIC_APP_VERSION_URL": "http://localhost:8082/api/v1/app/version",
        "EXPO_PUBLIC_SENTRY_ENVIRONMENT": "local"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "preview": {
      "environment": "preview",
      "distribution": "internal",
      "channel": "preview",
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "environment": "production",
      "channel": "production",
      "autoIncrement": true
    }
  },
  "submit": {
    "production": {}
  }
}
